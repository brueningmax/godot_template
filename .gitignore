# --- Godot ---------------------------------------------------------------
.godot/
/android/
# Generated from the CSV/PO sources; Godot recreates them on import.
*.translation
# Export signing keys and passwords. Never commit.
export_credentials.cfg

# --- Builds (export output) -------------------------------------------------
/build/

# --- .NET / C# ---------------------------------------------------------------
# (Godot 4 keeps C# build output in .godot/mono, already ignored above.)
mono_crash.*.json

# --- OS clutter ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*~

# --- Editors -----------------------------------------------------------------
# Only the shared VS Code files are committed; personal ones stay local.
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
.idea/
*.swp

# --- Python dev tools (gdtoolkit, pre-commit) ------------------------------
__pycache__/
.venv/
venv/

# --- graphify (knowledge graph, see .claude/skills/graphify) -----------------
# graph.json, GRAPH_REPORT.md and the cache are committed so new sessions can
# query and rebuild cheaply; these are regenerable or machine-specific.
graphify-out/graph.html
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cache/hook_sessions/
