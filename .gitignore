# --- Godot ---------------------------------------------------------------
.godot/
/android/
# Generated from the CSV/PO sources; Godot recreates them on import.
*.translation
# Export signing keys and passwords. Never commit.
export_credentials.cfg

# --- Builds (export output) -------------------------------------------------
/build/

# --- .NET / C# ---------------------------------------------------------------
# (Godot 4 keeps C# build output in .godot/mono, already ignored above.)
mono_crash.*.json

# --- OS clutter ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*~

# --- Editors -----------------------------------------------------------------
# Only the shared VS Code files are committed; personal ones stay local.
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
.idea/
*.swp

# --- Python dev tools (gdtoolkit, pre-commit) ------------------------------
__pycache__/
.venv/
venv/

# --- graphify (knowledge graph, see .claude/skills/graphify) -----------------
# Each session builds the graph at start-up (tools/graphify_rebuild.sh), so only
# its inputs are committed: the doc extraction cache, the community names and
# .gdignore. Everything else in graphify-out/ is a local build output.
graphify-out/*
!graphify-out/.gdignore
!graphify-out/community_names.json
!graphify-out/cache/
graphify-out/cache/*
!graphify-out/cache/semantic/
