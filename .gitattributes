# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Binary files: never diff, merge or convert line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.bmp binary
*.tga binary
*.exr binary
*.hdr binary
*.psd binary
*.kra binary
*.ase binary
*.aseprite binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.glb binary
*.blend binary
*.fbx binary
*.zip binary
*.pck binary

# --- Git LFS (opt-in per game) -----------------------------------------------
# Large binary assets can live in Git LFS instead of the normal history.
# To enable: see docs/TEMPLATE_GUIDE.md -> "Enabling Git LFS in your game",
# then uncomment the lines below (each replaces the plain "binary" line above).
# *.png filter=lfs diff=lfs merge=lfs -text
# *.jpg filter=lfs diff=lfs merge=lfs -text
# *.webp filter=lfs diff=lfs merge=lfs -text
# *.exr filter=lfs diff=lfs merge=lfs -text
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.kra filter=lfs diff=lfs merge=lfs -text
# *.aseprite filter=lfs diff=lfs merge=lfs -text
# *.ogg filter=lfs diff=lfs merge=lfs -text
# *.wav filter=lfs diff=lfs merge=lfs -text
